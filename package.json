{
  "name": "mcp-books",
  "version": "2.0.1",
  "description": "MCP server that searches the Internet Archive, the Library of Congress and data.bnf.fr at once, inside scanned text and across catalogues. No API key required.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "books",
    "archives",
    "full-text-search",
    "internet-archive",
    "library-of-congress",
    "bnf",
    "data-bnf",
    "newspapers",
    "ocr"
  ],
  "homepage": "https://github.com/smeet666/mcp-books#readme",
  "bugs": {
    "url": "https://github.com/smeet666/mcp-books/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/smeet666"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smeet666/mcp-books.git"
  },
  "license": "MIT",
  "author": {
    "name": "Damien Bouissou",
    "url": "https://github.com/smeet666"
  },
  "type": "module",
  "bin": {
    "mcp-books": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/sources/client.d.ts",
      "import": "./dist/sources/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PRIVACY.md",
    "server.json"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "mcpName": "io.github.smeet666/mcp-books",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "coverage": "vitest run test/unit --coverage",
    "build:manifest": "npm run build && node scripts/build-manifest-tools.mjs",
    "test:live": "vitest run test/live",
    "format": "biome check --write && prettier --write \"**/*.{md,yml}\"",
    "check": "biome ci && prettier --check \"**/*.{md,yml}\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "audit:floors": "node scripts/audit-floors.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mcp-archiveorg": "^2.0.0",
    "mcp-databnf": "^2.1.0",
    "mcp-libraryofcongress": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
